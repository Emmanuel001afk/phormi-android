<resources>
    <style name="Theme.Phormi" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#0F172A</item>
        <item name="colorPrimaryDark">#0F172A</item>
        <item name="colorAccent">#38BDF8</item>
        <item name="android:windowBackground">#0F172A</item>
    </style>
    <style name="PhormiStartAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_start_action</item>
        <item name="android:textColor">#E2E8F0</item>
        <item name="android:textSize">12sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
