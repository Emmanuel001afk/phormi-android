<resources>
    <style name="Theme.Phormi" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#0F172A</item>
        <item name="colorPrimaryDark">#0F172A</item>
        <item name="colorAccent">#38BDF8</item>
        <item name="android:windowBackground">#0F172A</item>
    </style>
    <style name="PhormiMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#E2E8F0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">#172235</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
