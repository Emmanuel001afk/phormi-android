<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Digital Assistant for Mayoko Needs"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add an AI by name + API key. Phormi detects the endpoint and available models automatically, chooses a suitable model, and keeps providers in a fallback chain."
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/key_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="#1E293B"
            android:padding="10dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/input_provider_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="AI name (e.g. Grok, OpenAI, Gemini, Groq)"
            android:inputType="text"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/input_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API key"
            android:inputType="textPassword"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/auto_detect_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Endpoint + model: automatic (never shown as required fields)"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <EditText android:id="@+id/input_endpoint" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />
        <EditText android:id="@+id/input_model" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">
            <Button
                android:id="@+id/btn_save_keys"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Run" />
            <Switch
                android:id="@+id/switch_ai_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="AI active"
                android:textColor="#E2E8F0" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Talk to your assistant"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <EditText
                android:id="@+id/input_instruction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Speak or type what you need"
                android:minLines="2"
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/btn_voice"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="🎙"
                android:contentDescription="Speak to assistant" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ask assistant"
            android:backgroundTint="#38BDF8"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progress"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />
        <TextView
            android:id="@+id/status_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add an AI provider to begin."
            android:textColor="#E2E8F0"
            android:background="#1E293B"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
