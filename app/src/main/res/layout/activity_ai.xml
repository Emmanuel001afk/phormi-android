<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phormi Browser AI"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect any AI service that exposes a reachable API. Phormi does not require one model, one vendor, or one model size. Use a direct native API, a generic HTTP JSON API, or Central Hub."
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/key_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="#1E293B"
            android:padding="10dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/input_provider_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Connection name (e.g. My Model Server)"
            android:inputType="text"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/input_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API key / access token"
            android:inputType="textPassword"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/input_endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API endpoint URL (https://...)"
            android:inputType="textUri"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/input_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Model ID (required for OpenAI-compatible APIs)"
            android:inputType="text"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/input_transport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OpenAI-compatible = common /v1/chat/completions-style API
Generic HTTP JSON = custom prompt/model/response fields
Central Hub = send the browser task to a Hub endpoint"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_template"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load endpoint preset" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp">
            <Button
                android:id="@+id/btn_save_keys"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save connection" />
            <Switch
                android:id="@+id/switch_ai_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="AI active"
                android:textColor="#E2E8F0" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Talk to your assistant"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <EditText
                android:id="@+id/input_instruction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Speak or type what you need"
                android:minLines="2"
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/btn_voice"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="🎙"
                android:contentDescription="Speak to assistant" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ask assistant"
            android:backgroundTint="#38BDF8"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progress"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />
        <TextView
            android:id="@+id/status_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add an AI connection to begin."
            android:textColor="#E2E8F0"
            android:background="#1E293B"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
