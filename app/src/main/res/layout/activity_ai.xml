<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ask_ai"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add any AI by name. Keys stay on this phone. If one fails, the next saved AI is tried (fallback)."
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/key_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="#1E293B"
            android:padding="10dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/input_provider_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="AI name (e.g. My Groq, Work OpenAI)"
            android:inputType="text"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/input_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API key"
            android:inputType="textPassword"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/input_endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Endpoint URL (optional — auto if common name)"
            android:inputType="textUri"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/input_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Model (e.g. llama-3.3-70b-versatile)"
            android:inputType="text"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btn_save_keys"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save AI" />

            <Button
                android:id="@+id/btn_templates"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Templates" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/instruction_label"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/input_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/instruction_hint"
            android:minLines="2"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/run_task"
            android:backgroundTint="#38BDF8"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_log_label"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/status_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/accessibility_reminder"
            android:textColor="#E2E8F0"
            android:background="#1E293B"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
