<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B1220">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Phormi AI" android:textColor="#F8FAFC" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Use Central Hub AI through Phormi’s shared AI tunnel, or configure a separate AI provider below." android:textColor="#94A3B8" android:textSize="13sp"/>
<Switch android:id="@+id/switch_ai_active" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Browser AI active" android:textColor="#E2E8F0"/><Switch android:id="@+id/switch_central_hub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Use Central Hub AI" android:textColor="#E2E8F0"/>
<Button android:id="@+id/btn_connect_hub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Connect Central Hub AI"/>
<Button android:id="@+id/btn_ai_memory_retention" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI memory retention"/>

<EditText android:id="@+id/input_provider_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Provider name (e.g. OpenAI)" android:textColor="#F8FAFC" android:textColorHint="#64748B"/>
<EditText android:id="@+id/input_api_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="API key" android:inputType="textPassword" android:textColor="#F8FAFC" android:textColorHint="#64748B"/>
<EditText android:id="@+id/input_endpoint" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="HTTPS chat endpoint" android:inputType="textUri" android:textColor="#F8FAFC" android:textColorHint="#64748B"/>
<EditText android:id="@+id/input_model" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Model ID" android:textColor="#F8FAFC" android:textColorHint="#64748B"/>
<Button android:id="@+id/btn_template" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose provider preset"/>
<Button android:id="@+id/btn_save_keys" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Test &amp; save connection"/>
<Button android:id="@+id/btn_manage_providers" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manage saved AI connections"/>
<Button android:id="@+id/btn_web_ai" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Use AI on the web inside Phormi"/>
<TextView android:id="@+id/key_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#CBD5E1"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Browser assistant · select a tab or let AI choose between open tabs. Page text is sent to your selected AI provider; private form values are never sent." android:textColor="#94A3B8" android:textSize="13sp"/>
<Button android:id="@+id/btn_ai_target" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Target: choose from open tabs"/>
<EditText android:id="@+id/input_instruction" android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="16dp" android:gravity="top" android:hint="Ask Phormi to do something on the current page" android:textColor="#F8FAFC" android:textColorHint="#64748B"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/btn_voice" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Voice"/><Button android:id="@+id/btn_run" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Run"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/btn_schedule" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Schedule"/><Button android:id="@+id/btn_tasks" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Waiting tasks"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scheduled tasks remind you when due; they only run after you approve them in the open browser. Sensitive actions such as payments or sign-in must be completed by you." android:textColor="#94A3B8" android:textSize="12sp"/>
<TextView android:id="@+id/status_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="#CBD5E1" android:textSize="13sp"/>
</LinearLayout>
</ScrollView>
