<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1220">

    <!-- ONE compact horizontal chrome layer only. -->
    <LinearLayout
        android:id="@+id/top_toolbar"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:background="#0F172A">

        <TextView
            android:id="@+id/btn_home"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="⌂"
            android:textColor="#E2E8F0"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Home" />

        <LinearLayout
            android:id="@+id/url_toolbar"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="2dp"
            android:background="#111827">

            <TextView
                android:layout_width="20dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#94A3B8"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/url_bar"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:hint="Search or type a URL"
                android:textColorHint="#94A3B8"
                android:textColor="#F1F5F9"
                android:textSize="12sp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:background="@android:color/transparent"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />

            <TextView
                android:id="@+id/btn_go"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="→"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/tab_strip"
            android:layout_width="150dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:visibility="gone"
            android:fillViewport="false"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:background="#0B1220">

            <LinearLayout
                android:id="@+id/tab_strip_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="1dp"
                android:paddingEnd="1dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tab_count"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:text="0"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_tab_count"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Tabs overview and tab count" />

        <TextView
            android:id="@+id/btn_new_tab"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#38BDF8"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="New tab" />

        <TextView
            android:id="@+id/btn_menu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#E2E8F0"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Menu" />
    </LinearLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/webview_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <include layout="@layout/activity_start_page" />

        <FrameLayout
            android:id="@+id/browser_lock_overlay_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <LinearLayout
        android:id="@+id/bottom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#0F172A">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#CBD5E1"
            android:textSize="24sp"
            android:background="@drawable/bg_nav_ring"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/btn_forward"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#CBD5E1"
            android:textSize="24sp"
            android:background="@drawable/bg_nav_ring"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Forward" />

        <TextView
            android:id="@+id/btn_bottom_ai"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="✦"
            android:textColor="#38BDF8"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openAiFromBottom"
            android:contentDescription="Ask AI" />

        <TextView
            android:id="@+id/btn_bottom_downloads"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:text="↓"
            android:textColor="#CBD5E1"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openDownloadsFromBottom"
            android:contentDescription="Downloads" />
    </LinearLayout>
</LinearLayout>
