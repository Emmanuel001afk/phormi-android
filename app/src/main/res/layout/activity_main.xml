<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ask_ai"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/api_keys_label"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/input_key_groq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Groq API key"
            android:inputType="textPassword"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/input_key_deepseek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="DeepSeek API key"
            android:inputType="textPassword"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/input_key_openai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="OpenAI API key"
            android:inputType="textPassword"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/input_key_gemini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gemini API key"
            android:inputType="textPassword"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_save_keys"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save_keys"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/instruction_label"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/input_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/instruction_hint"
            android:minLines="2"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/run_task"
            android:backgroundTint="#38BDF8"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_log_label"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/status_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/accessibility_reminder"
            android:textColor="#E2E8F0"
            android:background="#1E293B"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
