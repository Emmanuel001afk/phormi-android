<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/phormi_background">

    <!-- One 48dp chrome layer; 48dp touch targets remain accessible. -->
    <LinearLayout
        android:id="@+id/top_toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="@color/phormi_surface">

        <TextView
            android:id="@+id/btn_home"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⌂"
            android:textColor="@color/phormi_text"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Home" />

        <TextView
            android:id="@+id/btn_top_back"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:visibility="gone"
            android:text="‹"
            android:textColor="@color/phormi_text"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/btn_top_forward"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:visibility="gone"
            android:text="›"
            android:textColor="@color/phormi_text"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Forward" />

        <LinearLayout
            android:id="@+id/url_toolbar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.4"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="2dp"
            android:background="@color/phormi_surface">

            <TextView
                android:id="@+id/btn_site_info"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Site information and permissions"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="ⓘ"
                android:textColor="@color/phormi_secondary"
                android:textSize="16sp" />

            <AutoCompleteTextView
                android:id="@+id/url_bar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Search or type a URL"
                android:textColorHint="@color/phormi_secondary"
                android:textColor="@color/phormi_text"
                android:textSize="16sp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:background="@android:color/transparent"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />

            <TextView
                android:id="@+id/btn_go"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/phormi_accent"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Go to the address or search" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/tab_strip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:visibility="gone"
            android:fillViewport="false"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:background="@color/phormi_background">

            <LinearLayout
                android:id="@+id/tab_strip_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="1dp"
                android:paddingEnd="1dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/phormi_accent"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Refresh page" />

        <TextView
            android:id="@+id/btn_favorite"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:drawableTop="@drawable/ic_favorite_decagon"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Add or remove favorite" />

        <Space android:id="@+id/home_toolbar_spacer" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:visibility="gone" />
        <TextView
            android:id="@+id/tab_count"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/phormi_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_tab_count"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Tabs overview and tab count" />

        <TextView
            android:id="@+id/btn_new_tab"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/phormi_accent"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="New tab" />

        <TextView
            android:id="@+id/btn_top_downloads"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:visibility="gone"
            android:text="↓"
            android:textColor="@color/phormi_accent"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Downloads in progress" />

        <TextView
            android:id="@+id/btn_top_ai"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:visibility="gone"
            android:text="✦"
            android:textColor="@color/phormi_coral_text"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ask Phormi AI" />

        <TextView
            android:id="@+id/btn_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="@color/phormi_text"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Menu" />
    </LinearLayout>

    <ProgressBar android:id="@+id/page_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:max="100" android:visibility="gone" />
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/webview_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <FrameLayout
            android:id="@+id/split_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@color/phormi_background">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <FrameLayout android:id="@+id/split_top_host" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
                <View android:id="@+id/split_divider" android:layout_width="match_parent" android:layout_height="10dp" android:background="@color/phormi_surface" android:clickable="true" android:focusable="true" />
                <FrameLayout android:id="@+id/split_bottom_host" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            </LinearLayout>
            <TextView
                android:id="@+id/split_lock_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="🔒"
                android:textSize="18sp"
                android:background="@color/phormi_scrim"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Hide browser controls" />
        </FrameLayout>

        <include layout="@layout/activity_start_page" />

        <!-- A small overlay rather than an extra toolbar: progress stays visible while browsing. -->
        <TextView
            android:id="@+id/download_status_chip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:maxWidth="240dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/phormi_text"
            android:textSize="12sp"
            android:background="@drawable/bg_download_progress_chip"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="Download progress; open downloads" />

        <FrameLayout
            android:id="@+id/browser_lock_overlay_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <LinearLayout
        android:id="@+id/bottom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@color/phormi_surface">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/phormi_text"
            android:textSize="22sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/btn_forward"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/phormi_text"
            android:textSize="22sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Forward" />

        <TextView
            android:id="@+id/btn_bottom_ai"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="✦"
            android:textColor="@color/phormi_accent"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openAiFromBottom"
            android:contentDescription="Ask AI" />

        <TextView
            android:id="@+id/btn_bottom_downloads"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="↓"
            android:textColor="@color/phormi_text"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openDownloadsFromBottom"
            android:contentDescription="Downloads" />
    </LinearLayout>
</LinearLayout>
