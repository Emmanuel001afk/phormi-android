<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="30dp"
    android:minWidth="76dp"
    android:maxWidth="180dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:paddingStart="8dp"
    android:paddingEnd="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_tab_circle">

    <ImageView
        android:id="@+id/tab_chip_icon"
        android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="5dp"
        android:src="@drawable/ic_phormi_logo" android:contentDescription="Tab icon" />

    <TextView
        android:id="@+id/tab_chip_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxWidth="145dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="New tab"
        android:textColor="#F8FAFC"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tab_chip_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:text="×"
        android:textColor="#CBD5E1"
        android:textSize="16sp"
        android:contentDescription="Close tab" />
</LinearLayout>
