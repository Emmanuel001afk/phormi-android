<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1020">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="#101827">

        <TextView
            android:id="@+id/btn_downloads_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#E2E8F0"
            android:textSize="32sp"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Downloads"
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/btn_media_sources" android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="◉  Media sources on the current page"
        android:textColor="#978FFF" android:textSize="15sp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />

    <TextView
        android:id="@+id/downloads_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="32dp"
        android:text="No Phormi downloads yet."
        android:textColor="#94A3B8"
        android:textSize="15sp" />

    <ListView
        android:id="@+id/downloads_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#1E293B"
        android:dividerHeight="1dp" />
</LinearLayout>
