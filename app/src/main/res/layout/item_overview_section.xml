<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal">
    <View android:id="@+id/section_dot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_tab_add" />
    <TextView android:id="@+id/section_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/phormi_text" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/section_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/phormi_secondary" android:textSize="12sp" android:layout_marginEnd="6dp" />
    <TextView android:id="@+id/section_chevron" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center"
        android:textColor="@color/phormi_secondary" android:textSize="12sp" android:visibility="gone" android:importantForAccessibility="no" />
    <TextView android:id="@+id/btn_open_section" android:layout_width="wrap_content" android:minWidth="40dp" android:layout_height="40dp"
        android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="Open" android:textColor="@color/phormi_accent"
        android:textSize="11sp" android:textStyle="bold" android:visibility="gone" android:clickable="true" android:focusable="true"
        android:background="?attr/selectableItemBackground" />
    <TextView android:id="@+id/btn_manage_section" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center"
        android:text="⋯" android:textColor="@color/phormi_text" android:textSize="18sp" android:visibility="gone" android:clickable="true" android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" />
</LinearLayout>
