<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textColor="#F8FAFC"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/menu_new_tab"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:text="New tab"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_ghost"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Ghost mode"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_tabs"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Tab overview"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_groups"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Tab Groups"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_downloads"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Downloads"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_bookmarks"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Bookmarks"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_history"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="History"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_vpn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="VPN"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_ai"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Ask AI"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_local_ai"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Local AI on this device"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_video_analysis"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Analyze current video with AI"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_keyboard"
            android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical"
            android:text="Phormi Keyboard" android:textColor="#E2E8F0" android:textSize="16sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1E293B" android:clickable="true" android:focusable="true" />
        <TextView
            android:id="@+id/menu_default_browser"
            android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical"
            android:text="Default browser" android:textColor="#E2E8F0" android:textSize="16sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1E293B" android:clickable="true" android:focusable="true" />
        <TextView
            android:id="@+id/menu_security"
            android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical"
            android:text="Security Center" android:textColor="#E2E8F0" android:textSize="16sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1E293B" android:clickable="true" android:focusable="true" />
        <TextView
            android:id="@+id/menu_site_lock"
            android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical"
            android:text="Site lock" android:textColor="#E2E8F0" android:textSize="16sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1E293B" android:clickable="true" android:focusable="true" />
        <TextView
            android:id="@+id/menu_notifications"
            android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical"
            android:text="Notifications" android:textColor="#E2E8F0" android:textSize="16sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1E293B" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/menu_find" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="Find in page" android:textColor="#E2E8F0" android:textSize="16sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1E293B" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/menu_share" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="Share page" android:textColor="#E2E8F0" android:textSize="16sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1E293B" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/menu_navigation_lens" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="Navigation Lens" android:textColor="#E2E8F0" android:textSize="16sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1E293B" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/menu_object_anchors" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="Object Anchors" android:textColor="#E2E8F0" android:textSize="16sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1E293B" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/menu_same_page_split" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="Same-page split" android:textColor="#E2E8F0" android:textSize="16sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1E293B" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/menu_desktop_mode" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="Desktop site" android:textColor="#E2E8F0" android:textSize="16sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1E293B" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/menu_favorite" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="Favorite current page" android:textColor="#E2E8F0" android:textSize="16sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1E293B" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/menu_keep_screen_on" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="Keep screen on" android:textColor="#E2E8F0" android:textSize="16sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1E293B" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/menu_help" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="Help" android:textColor="#E2E8F0" android:textSize="16sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1E293B" android:clickable="true" android:focusable="true" />
        <TextView
            android:id="@+id/menu_browser_lock"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Browser Lock"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_pull_to_refresh"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Pull-to-refresh"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_split_screen"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Split screen"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_tab_retention"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Tab retention"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_theme"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Theme and wallpaper"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Accounts &amp; sign-in"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/menu_close"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Close"
            android:textColor="#38BDF8"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</ScrollView>
