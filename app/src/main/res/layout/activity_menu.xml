<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phormi"
            android:textColor="#F8FAFC"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Browser menu"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="14dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TABS &amp; BROWSING" android:textColor="#38BDF8" android:textStyle="bold" android:textSize="12sp" android:padding="6dp"/>
        <TextView android:id="@+id/menu_new_tab" style="@style/PhormiMenuItem" android:text="＋  New tab"/>
        <TextView android:id="@+id/menu_ghost" style="@style/PhormiMenuItem" android:text="◌  Ghost mode"/>
        <TextView android:id="@+id/menu_tabs" style="@style/PhormiMenuItem" android:text="▣  Tab overview"/>
        <TextView android:id="@+id/menu_groups" style="@style/PhormiMenuItem" android:text="▦  Tab Groups"/>
        <TextView android:id="@+id/menu_tab_environment" style="@style/PhormiMenuItem" android:text="◎  Tab environments"/>
        <TextView android:id="@+id/menu_same_page_split" style="@style/PhormiMenuItem" android:text="▥  Same-page split"/>
        <TextView android:id="@+id/menu_split_screen" style="@style/PhormiMenuItem" android:text="◫  Split screen"/>
        <TextView android:id="@+id/menu_tab_retention" style="@style/PhormiMenuItem" android:text="◷  Tab retention"/>
        <TextView android:id="@+id/menu_pull_to_refresh" style="@style/PhormiMenuItem" android:text="↻  Pull-to-refresh"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PAGE" android:textColor="#38BDF8" android:textStyle="bold" android:textSize="12sp" android:padding="6dp" android:paddingTop="16dp"/>
        <TextView android:id="@+id/menu_bookmarks" style="@style/PhormiMenuItem" android:text="☆  Bookmarks"/>
        <TextView android:id="@+id/menu_history" style="@style/PhormiMenuItem" android:text="◴  History"/>
        <TextView android:id="@+id/menu_favorites" style="@style/PhormiMenuItem" android:text="★  Favorites"/>
        <TextView android:id="@+id/menu_favorite" style="@style/PhormiMenuItem" android:text="★  Favorite current page"/>
        <TextView android:id="@+id/menu_find" style="@style/PhormiMenuItem" android:text="⌕  Find in page"/>
        <TextView android:id="@+id/menu_share" style="@style/PhormiMenuItem" android:text="↗  Share page"/>
        <TextView android:id="@+id/menu_downloads" style="@style/PhormiMenuItem" android:text="⇩  Downloads"/>
        <TextView android:id="@+id/menu_desktop_mode" style="@style/PhormiMenuItem" android:text="▣  Desktop mode"/>
        <TextView android:id="@+id/menu_install_site" style="@style/PhormiMenuItem" android:text="⌂  Add site to home screen"/>
        <TextView android:id="@+id/menu_install_web_app" style="@style/PhormiMenuItem" android:text="▣  Install web app"/>
        <TextView android:id="@+id/menu_keep_screen_on" style="@style/PhormiMenuItem" android:text="◉  Keep screen on"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TOOLS" android:textColor="#38BDF8" android:textStyle="bold" android:textSize="12sp" android:padding="6dp" android:paddingTop="16dp"/>
        <TextView android:id="@+id/menu_ai" style="@style/PhormiMenuItem" android:text="✦  Ask AI"/>
        <TextView android:id="@+id/menu_keyboard" style="@style/PhormiMenuItem" android:text="⌨  Phormi Keyboard"/>
        <TextView android:id="@+id/menu_capsule" style="@style/PhormiMenuItem" android:text="◈  Phormi Capsule"/>
        <TextView android:id="@+id/menu_navigation_lens" style="@style/PhormiMenuItem" android:text="⌖  Navigation Lens"/>
        <TextView android:id="@+id/menu_object_anchors" style="@style/PhormiMenuItem" android:text="⊙  Object Anchors"/>
        <TextView android:id="@+id/menu_disposable_email" style="@style/PhormiMenuItem" android:text="✉  Disposable Email Lab"/>
        <TextView android:id="@+id/menu_vpn" style="@style/PhormiMenuItem" android:text="⇄  VPN"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PRIVACY &amp; APP" android:textColor="#38BDF8" android:textStyle="bold" android:textSize="12sp" android:padding="6dp" android:paddingTop="16dp"/>
        <TextView android:id="@+id/menu_browser_lock" style="@style/PhormiMenuItem" android:text="▣  Browser Lock"/>
        <TextView android:id="@+id/menu_site_lock" style="@style/PhormiMenuItem" android:text="⌑  Site lock"/>
        <TextView android:id="@+id/menu_security" style="@style/PhormiMenuItem" android:text="✓  Security Center"/>
        <TextView android:id="@+id/menu_notifications" style="@style/PhormiMenuItem" android:text="♢  Notifications"/>
        <TextView android:id="@+id/menu_default_browser" style="@style/PhormiMenuItem" android:text="◎  Default browser"/>
        <TextView android:id="@+id/menu_theme" style="@style/PhormiMenuItem" android:text="◐  Theme &amp; wallpaper"/>
        <TextView android:id="@+id/menu_settings" style="@style/PhormiMenuItem" android:text="☻  Accounts &amp; sign-in"/>
        <TextView android:id="@+id/menu_help" style="@style/PhormiMenuItem" android:text="ℹ  Help"/>

        <TextView android:id="@+id/menu_local_ai" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/>
        <TextView android:id="@+id/menu_video_analysis" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/>

        <TextView
            android:id="@+id/menu_close"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Close menu"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:background="#101B2D"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</ScrollView>