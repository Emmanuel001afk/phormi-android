<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#0B1220">
    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:gravity="center_vertical" android:background="#0F172A">
        <TextView android:id="@+id/news_back" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="‹" android:textColor="#F8FAFC" android:textSize="28sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="News" android:textColor="#F8FAFC" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp" android:text="Tap a story to open it. Long-press a story to tell Phormi you want more like it." android:textColor="#94A3B8" android:textSize="11sp" />
    <ListView android:id="@+id/news_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#202B3C" android:dividerHeight="1dp" />
</LinearLayout>
