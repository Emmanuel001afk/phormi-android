<?xml version="1.0" encoding="utf-8"?>
<!--
  Ring around the rear opening of the back/forward glyph.
  Transparent centre so the ‹ / › character stays visible;
  stroke forms a circle hugging the back edge of the arrow, not a filled disc covering it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="#64748B" />
</shape>
